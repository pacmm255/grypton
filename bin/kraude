#!/usr/bin/env python3
"""Source-checkout launcher for the GLM-backed Kraude role console."""
import os
from pathlib import Path
import sys

project = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(project))
os.environ.setdefault("GRYPTON_ROOT", str(project))
from grypton.cli import worker_main

raise SystemExit(worker_main())
