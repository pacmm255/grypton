#!/usr/bin/env python3
"""Source-checkout launcher for Grypton's scoped tool surface."""
import os
from pathlib import Path
import sys

project = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(project))
os.environ.setdefault("GRYPTON_HOME", str(project))
from grypton.toolserver import cli_main

raise SystemExit(cli_main())
